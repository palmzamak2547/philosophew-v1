# Every variable Philosophew reads. Copy this file to .env.local (git ignores it) and fill in only what you use:
# the static app needs none of them, so npm run dev and npm run build work with no .env file at all.
# `neon env pull` also writes NEON_* and AWS_* values for Neon Auth and object storage; this app reads none of them.

# The browser bundle. Vite writes VITE_* values into the public JavaScript: never put a secret here.
# The Google OAuth client id for the sign-in button; left empty, only the emailed code is offered.
VITE_GOOGLE_CLIENT_ID=

# The development server (vite.config.ts).
# Where npm run dev proxies /api: your Neon Function's address, or http://localhost:8787 for scripts/api-local.mjs.
NEON_FUNCTION_API_BASE_URL=

# The API (api/index.ts). npm run deploy:api hands the five after the connection strings to the Neon Function (neon.ts)
# and needs each of them set.
# The Postgres connection string: Neon Functions inject it at run time; `neon env pull` writes it here for the scripts.
DATABASE_URL=
# The direct (unpooled) connection string; npm run migrate and scripts/check-api.mjs prefer it when it is set.
DATABASE_URL_UNPOOLED=
# A long random string that keys the sign-in code and device-link hashes; without it the account routes answer 503.
SESSION_SECRET=
# A long random string mixed into visitors' IP hashes for the rate limits; unset, the API uses a fixed development value.
IP_SALT=
# The Resend API key that mails the sign-in codes (the sender's address is written in api/index.ts).
RESEND_API_KEY=
# The Google OAuth client id again: the audience a Google ID token must carry; left empty, Google sign-in is refused.
GOOGLE_CLIENT_ID=
# Moderators: comma-separated addresses that open /admin after signing in with an emailed code.
ADMIN_EMAILS=
# 1 prints sign-in codes to the console instead of mailing them: local development only (scripts/api-local.mjs sets it).
DEV_LOG_CODES=

# Scripts, all optional.
# Your IndexNow key for scripts/indexnow.mjs; the site must serve public/<key>.txt holding it.
INDEXNOW_KEY=
# The app's address for scripts/perf-longtasks.mjs and scripts/perf-profile.mjs (default http://localhost:5178).
BASE=
# A Unix time for the sitemap's lastmod in scripts/prerender.mjs, for a reproducible build (default: now).
SOURCE_DATE_EPOCH=
